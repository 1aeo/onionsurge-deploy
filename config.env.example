# Copy to config.env, chmod 600, and keep it private. Never commit the real file.
# Values are assignments, not shell commands. Use quotes around spaces.
APPLICATION_DIR="${HOME}/onionsurge"
APPLICATION_COMMIT=""
DEPLOYMENT_COMMIT=""
STATE_DIR="${HOME}/.local/state/onionsurge"
LOG_DIR="${HOME}/.local/state/onionsurge/logs"
# Completed runs/, candidates/, and cloudflare-* staging directories to retain (`2..168`, default 3; active root current/previous releases are always kept).
STATE_RETAIN_RUNS="3"
CRON_MINUTE="5"
# Opt in on cron hosts that cannot schedule in UTC or have non-hour offsets (for example, half-hour zones).
# A trusted system date checks UTC each minute; only the selected minute starts the hourly runner.
CRON_UTC_GATE="false"

# Private mode-0600 collector source configuration passed to onionsurge/scripts/collect.py.
SOURCE_CONFIG="${HOME}/.config/onionsurge/source.env"
# Optional private JSON time-range policy file passed to onionsurge/scripts/build.py --time-ranges.
TIME_RANGES_CONFIG=""

# Optional DigitalOcean Spaces bucket (enable only with protected prefix and Cloudflare Worker routing).
DO_ENABLED="false"
DO_SPACES_REGION=""
DO_SPACES_BUCKET=""
DO_SPACES_PREFIX="onionsurge"
DO_SPACES_KEY=""
DO_SPACES_SECRET=""
RCLONE_PATH="${HOME}/bin/rclone"

# Optional Cloudflare routing and static frontend (needed when publishing to Spaces/R2 instead of LOCAL_ENABLED).
CLOUDFLARE_ACCOUNT_ID=""
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""
# Optional custom hostnames (default to example.com and onionsurge.<canonical_host> when blank).
CLOUDFLARE_CANONICAL_HOST=""
CLOUDFLARE_REDIRECT_HOST=""
WORKER_NAME="onionsurge"
ROOT_CACHE_GENERATION=""

# Optional second backend: all enabled backends must verify before promotion.
R2_ENABLED="false"
R2_BUCKET=""
R2_PREFIX="onionsurge"
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""

# Private local/VPN hosting (default; when DO_ENABLED="false" and R2_ENABLED="false", no cloud credentials are needed).
LOCAL_ENABLED="true"
LOCAL_SITE_DIR=""
LOCAL_BIND_ADDR="127.0.0.1:8781"
LOCAL_TLS_BIND_ADDR=""
LOCAL_URL_PREFIX="/"
LOCAL_RETAIN_RELEASES="3"
