# Example Caddy v2 configuration generated by scripts/local_site.py --print-caddy.
# Keep ONIONSURGE bound strictly to loopback (for tailscale serve) or a tailnet/VPN IP.

http://:8781 {
    bind 127.0.0.1
    header {
        X-Robots-Tag "noindex, nofollow"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        X-Frame-Options "DENY"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        Permissions-Policy "accelerometer=(), browsing-topics=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()"
        -Server
    }
    @onionsurge_root path /
    handle @onionsurge_root {
        root * "/srv/onionsurge/current"
        rewrite * /index.html
        header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
        header Cache-Control "no-store"
        file_server
    }
    @onionsurge_index path /index.html
    handle @onionsurge_index {
        root * "/srv/onionsurge/current"
        header Content-Security-Policy "default-src 'none'; script-src 'self'; style-src 'self' 'unsafe-inline'; style-src-elem 'self'; style-src-attr 'unsafe-inline'; img-src 'self'; connect-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
        header Cache-Control "no-store"
        file_server
    }
    @onionsurge_assets path /app.js /live.js /style.css
    handle @onionsurge_assets {
        root * "/srv/onionsurge/current"
        header Content-Security-Policy "default-src 'none'; sandbox; frame-ancestors 'none'"
        header Cache-Control "no-store"
        file_server
    }
    @onionsurge_manifest path /data/manifest.json
    handle @onionsurge_manifest {
        root * "/srv/onionsurge"
        header Content-Security-Policy "default-src 'none'; sandbox; frame-ancestors 'none'"
        header Cache-Control "no-store"
        file_server
    }
    @onionsurge_legacy path_regexp legacy_csv ^/data/releases/.+-(?:0*[01]d|0+[0-9]*h|(?:[0-9]|1[0-9]|2[0-3])h|[0-9]+[sm])\.csv$
    handle @onionsurge_legacy {
        respond 404
    }
    @onionsurge_release path_regexp release_obj ^/data/releases/[A-Za-z0-9][A-Za-z0-9_.-]{0,95}/(?:manifest\.json|data\.json|reference/reference-[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-f0-9]{12}\.json|exports/[a-z][a-z0-9_-]{0,95}-[a-z0-9]+(?:-[a-z0-9]+){0,7}\.csv)$
    handle @onionsurge_release {
        root * "/srv/onionsurge"
        header Content-Security-Policy "default-src 'none'; sandbox; frame-ancestors 'none'"
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        respond 404
    }
}
